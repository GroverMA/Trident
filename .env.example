# HKGAI Modelhub
HKGAI_MODEL_API_KEY=
HKGAI_MODEL_BASE_URL=https://test-new-api.hkchat.app
HKGAI_MODEL_NAME=t2_hkgai-v3_fp8_1m_e7

# HKGAI Agenthub
HKGAI_AGENTHUB_ENDPOINT=https://search-agent.prod.hkchat.app/v1/tool/search-agent
HKGAI_SEARCH_MCP_URL=https://search-agent-mcp.prod.hkchat.app/mcp
HKGAI_SEARCH_BASE_URL=https://search-agent.prod.hkchat.app/v1
HKGAI_SEARCH_TRANSPORT=auto
HKGAI_APP_NAME=
HKGAI_APP_KEY=

# Conservative defaults for the MVP
HKGAI_MODEL_TIMEOUT_SECONDS=120
HKGAI_SEARCH_TIMEOUT_SECONDS=300

# Optional methodology override. Leave empty to use the bundled baseline pack.
# RESEARCH_SOP_PACK_PATH=knowledge_packs/research_sop/trident_industry_research_v2.json

# Persistence
# development/test: DATABASE_URL is optional and local SQLite is used when absent.
# staging/production: DATABASE_URL is mandatory; no SQLite failover is permitted.
TRIDENT_ENV=development
# Leave empty for automatic local behavior. Use `sqlite` for a single-instance
# demo, or `database_url` for a shared PostgreSQL customer deployment.
TRIDENT_DATABASE_MODE=
TRIDENT_DATABASE_PATH=data/trident.db
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
